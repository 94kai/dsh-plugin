{
  "name": "@local/pocket-kit",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "随身工具箱：文件、进京证、健康、终端、记账单、音乐与日常工具",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./shortcuts": "./features/shortcuts/index.js",
    "./network-speed": "./features/network-speed/host.js",
    "./outing-checklist": "./features/outing-checklist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./shortcuts/locale/*.json": "./features/shortcuts/locale/*.json",
    "./shortcuts/icon": "./features/shortcuts/icon.svg",
    "./network-speed/locale/*.json": "./features/network-speed/host-locale/*.json",
    "./network-speed/icon": "./features/network-speed/icon.svg",
    "./outing-checklist/locale/*.json": "./features/outing-checklist/locale/*.json",
    "./outing-checklist/icon": "./features/outing-checklist/icon.svg",
    "./music": "./features/music/host.mjs",
    "./music/locale/*.json": "./features/music/locale/*.json",
    "./music/icon": "./features/music/icon.svg",
    "./xiaoai": "./features/xiaoai/host.mjs",
    "./xiaoai/locale/*.json": "./features/xiaoai/locale/*.json",
    "./xiaoai/icon": "./features/xiaoai/icon.svg",
    "./file-manager": "./features/file-manager/host.mjs",
    "./file-manager/locale/*.json": "./features/file-manager/locale/*.json",
    "./file-manager/icon": "./features/file-manager/icon.svg",
    "./health": "./features/health/host.mjs",
    "./health/locale/*.json": "./features/health/locale/*.json",
    "./health/icon": "./features/health/icon.svg",
    "./beijing-pass": "./features/beijing-pass/host.mjs",
    "./beijing-pass/locale/*.json": "./features/beijing-pass/locale/*.json",
    "./beijing-pass/icon": "./features/beijing-pass/icon.svg",
    "./bill-manager": "./features/bill-manager/host.mjs",
    "./bill-manager/locale/*.json": "./features/bill-manager/locale/*.json",
    "./bill-manager/icon": "./features/bill-manager/icon.svg"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "features/shortcuts/index.js",
    "features/shortcuts/locale/*.json",
    "features/shortcuts/icon.svg",
    "features/network-speed/host.js",
    "features/network-speed/server.js",
    "features/network-speed/host-locale/*.json",
    "features/network-speed/icon.svg",
    "features/outing-checklist/index.js",
    "features/outing-checklist/store.js",
    "features/outing-checklist/locale/*.json",
    "features/outing-checklist/icon.svg",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "lib/*.mjs",
    "features/music/*.mjs",
    "features/music/locale/*.json",
    "features/music/icon.svg",
    "features/xiaoai/*.mjs",
    "features/xiaoai/worker_bridge.py",
    "features/xiaoai/automation_runtime.py",
    "features/xiaoai/runtime/**/*.py",
    "features/xiaoai/requirements.txt",
    "features/xiaoai/stop-commands.json",
    "features/xiaoai/locale/*.json",
    "features/xiaoai/icon.svg",
    "features/file-manager/*.mjs",
    "features/file-manager/locale/*.json",
    "features/file-manager/icon.svg",
    "features/health/*.mjs",
    "features/health/locale/*.json",
    "features/health/icon.svg",
    "features/beijing-pass/*.mjs",
    "features/beijing-pass/locale/*.json",
    "features/beijing-pass/icon.svg",
    "features/bill-manager/*.mjs",
    "features/bill-manager/locale/*.json",
    "features/bill-manager/icon.svg",
    "features/health/columns.json",
    "features/terminal-touch-keys/bridge.mjs",
    "features/terminal-touch-keys/sidebar-bridge.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test features/*/*.test.js tests/*.test.js",
    "verify": "npm run build && npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "pdfjs-dist": "^5.4.149"
  }
}
